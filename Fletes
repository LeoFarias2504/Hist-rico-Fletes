<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Freddo Comex - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 min-h-screen">

    <header class="bg-[#003366] text-white p-4 shadow-lg">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold tracking-tighter italic">FREDDO <span class="font-light text-blue-300">COMEX APP</span></h1>
            <div class="text-xs text-right">
                <p>Pasante: Control de Fletes</p>
                <p class="opacity-70">Argentina</p>
            </div>
        </div>
    </header>

    <main class="container mx-auto p-4 md:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-1 bg-white p-6 rounded-2xl shadow-xl border-t-4 border-[#003366]">
                <h2 class="text-[#003366] font-bold text-lg mb-4 flex items-center">
                    📝 Nueva Cotización
                </h2>
                <form id="quoteForm" class="space-y-4">
                    <input type="text" name="referencia" placeholder="Ref. Expo (Ej: EXP-101)" class="w-full p-2 border rounded shadow-sm focus:outline-blue-500" required>
                    <input type="text" name="destino" placeholder="Destino (Ej: Chile)" class="w-full p-2 border rounded shadow-sm focus:outline-blue-500" required>
                    
                    <select name="modalidad" class="w-full p-2 border rounded shadow-sm bg-gray-50">
                        <option>Marítimo</option>
                        <option>Terrestre</option>
                        <option>Aéreo</option>
                    </select>

                    <input type="text" name="carrier" placeholder="Naviera / Transportista" class="w-full p-2 border rounded shadow-sm" required>
                    
                    <div class="grid grid-cols-2 gap-2">
                        <input type="number" name="flete" placeholder="Flete USD" class="p-2 border rounded shadow-sm" required>
                        <input type="number" name="gastos_locales" placeholder="Gastos USD" class="p-2 border rounded shadow-sm" required>
                    </div>

                    <button type="submit" id="btnSubmit" class="w-full bg-[#003366] text-white font-bold py-3 rounded-xl hover:bg-blue-900 transition-all shadow-md">
                        GUARDAR DATOS
                    </button>
                </form>
                <p id="statusMsg" class="hidden mt-4 text-center font-bold text-green-600 animate-pulse">¡Registrado con éxito!</p>
            </div>

            <div class="lg:col-span-2 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-blue-50 p-6 rounded-2xl border border-blue-100 shadow-sm">
                        <p class="text-blue-800 text-xs font-bold uppercase">Promedio Regional</p>
                        <h3 class="text-3xl font-black text-[#003366]" id="kpiAvg">USD 1.450</h3>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                        <p class="text-gray-500 text-xs font-bold uppercase">Total Operaciones</p>
                        <h3 class="text-3xl font-black text-gray-800" id="kpiTotal">12</h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                        <h4 class="text-xs font-bold text-gray-400 mb-4 uppercase text-center">Costos por Destino</h4>
                        <canvas id="chartBarras"></canvas>
                    </div>
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
                        <h4 class="text-xs font-bold text-gray-400 mb-4 uppercase text-center">Mix de Transporte</h4>
                        <canvas id="chartTorta"></canvas>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        // URL DE TU GOOGLE SCRIPT
        const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxg3ZiHoRNF64b-y_yGe_FpVmyuA9uqt_yrutnMGxFKghy1eXPhz0GLpHIHXw7IJm01YA/exec';
        
        const form = document.getElementById('quoteForm');
        const btn = document.getElementById('btnSubmit');
        const status = document.getElementById('statusMsg');

        form.addEventListener('submit', e => {
            e.preventDefault();
            btn.disabled = true;
            btn.innerText = 'ENVIANDO...';

            fetch(SCRIPT_URL, { method: 'POST', body: new FormData(form) })
            .then(res => {
                status.classList.remove('hidden');
                form.reset();
                btn.disabled = false;
                btn.innerText = 'GUARDAR DATOS';
                setTimeout(() => status.classList.add('hidden'), 4000);
            })
            .catch(err => {
                alert('Error al conectar con Google Sheets');
                btn.disabled = false;
                btn.innerText = 'REINTENTAR';
            });
        });

        // Configuración de Gráficos (Datos iniciales para que no se vea vacío)
        const ctxBar = document.getElementById('chartBarras').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: ['Chile', 'Uruguay', 'Brasil', 'Perú'],
                datasets: [{
                    label: 'Flete USD',
                    data: [850, 600, 1200, 2100],
                    backgroundColor: '#003366',
                    borderRadius: 5
                }]
            }
        });

        const ctxPie = document.getElementById('chartTorta').getContext('2d');
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: ['Marítimo', 'Terrestre', 'Aéreo'],
                datasets: [{
                    data: [70, 20, 10],
                    backgroundColor: ['#003366', '#3b82f6', '#93c5fd']
                }]
            }
        });
    </script>
</body>
</html>
