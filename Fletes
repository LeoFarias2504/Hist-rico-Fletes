<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Freddo Argentina - Control de Cotizaciones</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .freddo-blue { background-color: #003366; }
        .freddo-text { color: #003366; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen pb-10">

    <nav class="freddo-blue p-4 shadow-md mb-8">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-white font-bold text-xl tracking-wider">FREDDO COMEX</h1>
            <span class="text-blue-200 text-sm italic">Gestión de Cotizaciones Marítimas</span>
        </div>
    </nav>

    <div class="container mx-auto px-4 max-w-3xl">
        <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
            <div class="p-6 freddo-blue">
                <h2 class="text-white text-lg font-semibold">Carga de Nueva Operación</h2>
                <p class="text-blue-100 text-xs">Completa los datos para alimentar el histórico y promedios.</p>
            </div>

            <form id="comexForm" class="p-8 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Ref. Exportación</label>
                    <input type="text" name="referencia" placeholder="Ej: EXPO-FREDDO-01" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition" required>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Puerto / Ciudad Destino</label>
                    <input type="text" name="destino" placeholder="Ej: Callao, Perú" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition" required>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Modalidad</label>
                    <select name="modalidad" class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition">
                        <option value="Marítimo">Marítimo</option>
                        <option value="Terrestre">Terrestre</option>
                        <option value="Aéreo">Aéreo</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Incoterm</label>
                    <input type="text" name="incoterm" placeholder="Ej: FOB / CFR" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tipo de Contenedor</label>
                    <input type="text" name="contenedor" placeholder="Ej: 40' High Cube Reefer" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Naviera / Carrier</label>
                    <input type="text" name="carrier" placeholder="Ej: Maersk / MSC" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition" required>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Transit Time (Días)</label>
                    <input type="number" name="transit_time" placeholder="0" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Flete Internacional (USD)</label>
                    <input type="number" step="0.01" name="flete" placeholder="0.00" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition" required>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Gastos Locales (USD)</label>
                    <input type="number" step="0.01" name="gastos_locales" placeholder="0.00" 
                        class="w-full border border-gray-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 outline-none transition" required>
                </div>

                <div class="md:col-span-2 mt-4">
                    <button type="submit" id="btnEnviar" 
                        class="w-full freddo-blue text-white font-bold py-4 rounded-xl hover:opacity-90 transition shadow-lg flex justify-center items-center">
                        <span id="btnText">GUARDAR EN EXCEL ONLINE</span>
                    </button>
                </div>
            </form>
            
            <div id="successMsg" class="hidden p-4 bg-green-100 border-t border-green-200 text-green-700 text-center font-semibold">
                ¡Datos guardados con éxito en la base de datos de Freddo!
            </div>
        </div>
        <p class="text-center mt-6 text-gray-400 text-xs">Herramienta interna de uso exclusivo para el área de Comercio Exterior.</p>
    </div>

    <script>
        const scriptURL = 'https://script.google.com/macros/s/AKfycbxg3ZiHoRNF64b-y_yGe_FpVmyuA9uqt_yrutnMGxFKghy1eXPhz0GLpHIHXw7IJm01YA/exec';
        const form = document.getElementById('comexForm');
        const btn = document.getElementById('btnEnviar');
        const btnText = document.getElementById('btnText');
        const successMsg = document.getElementById('successMsg');

        form.addEventListener('submit', e => {
            e.preventDefault();
            
            // Estado de carga
            btn.disabled = true;
            btn.style.opacity = "0.7";
            btnText.innerText = "PROCESANDO...";

            fetch(scriptURL, { method: 'POST', body: new FormData(form)})
                .then(response => {
                    successMsg.classList.remove('hidden');
                    form.reset();
                    btn.disabled = false;
                    btn.style.opacity = "1";
                    btnText.innerText = "GUARDAR EN EXCEL ONLINE";
                    
                    // Ocultar mensaje de éxito después de 5 segundos
                    setTimeout(() => {
                        successMsg.classList.add('hidden');
                    }, 5000);
                })
                .catch(error => {
                    console.error('Error!', error.message);
                    alert('Hubo un error al conectar con el servidor.');
                    btn.disabled = false;
                    btnText.innerText = "REINTENTAR";
                });
        });
    </script>
</body>
</html>
